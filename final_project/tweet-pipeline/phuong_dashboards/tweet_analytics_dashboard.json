{
  "datasets": [
    {
      "name": "aaf83faa",
      "displayName": "Total Tweets",
      "queryLines": [
        "select count(*) as total_tweets\n",
        "from tweets_bronze;"
      ]
    },
    {
      "name": "510ba740",
      "displayName": "Tweets with Mentions",
      "queryLines": [
        "select count(*) as tweets_with_mentions\n",
        "from tweets_silver\n",
        "where mention is not null;"
      ]
    },
    {
      "name": "51984b8e",
      "displayName": "Tweets without Mentions",
      "queryLines": [
        "select count(*) as tweets_without_mentions\n",
        "from tweets_silver\n",
        "where mention is null;"
      ]
    },
    {
      "name": "96da3b17",
      "displayName": "Top 10 Users by Tweet Count",
      "queryLines": [
        "select user, count(*) as tweet_count\n",
        "from tweets_bronze\n",
        "group by user\n",
        "order by tweet_count desc\n",
        "limit 10;"
      ]
    },
    {
      "name": "66f692a3",
      "displayName": "Top 10 Most Positively Mentioned",
      "queryLines": [
        "select mention, positive\n",
        "from gold_tweet_aggregations\n",
        "where mention is not null\n",
        "order by positive desc\n",
        "limit 10;"
      ]
    },
    {
      "name": "da68ff51",
      "displayName": "Top 10 Most Negatively Mentioned",
      "queryLines": [
        "select mention, negative\n",
        "from gold_tweet_aggregations\n",
        "where mention is not null\n",
        "order by negative desc\n",
        "limit 10;"
      ]
    }
  ],
